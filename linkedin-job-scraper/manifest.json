{
  "manifest_version": 3,
  "name": "LinkedIn Job Scraper",
  "version": "1.0.0",
  "description": "Scrape LinkedIn job search results and export structured job data as CSV or JSON.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkedIn Job Scraper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/search*",
        "https://www.linkedin.com/jobs/search/*",
        "https://www.linkedin.com/jobs/collections*",
        "https://www.linkedin.com/jobs/collections/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content_job.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
